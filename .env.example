ANTHROPIC_API_KEY=your_anthropic_api_key_here
# 워크스페이스에 묶이지 않은 키라면 콘솔의 워크스페이스 ID(wrkspc_...)도 입력
ANTHROPIC_WORKSPACE_ID=
# API 키 없이 시연하려면 offline (검색 결과만 표시). 키가 없으면 자동으로 오프라인 모드로 시작
LLM_MODE=offline

# ── 배포 · 운영 설정 (비워 두면 기본값) ──
# 입장 코드: 설정하면 코드를 아는 사람만 사용 (API 비용 보호)
APP_PASSWORD=
# 하루 API 비용 상한(USD, 한국 시간 기준). 넘으면 오프라인 모드로 전환. 기본 2
DAILY_BUDGET_USD=2
# 접속(브라우저 세션)당 AI 답변 횟수 상한. 기본 30
MAX_QUESTIONS_PER_SESSION=30
